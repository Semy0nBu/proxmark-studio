+#ifndef COMMS_BULK_DOWNLOAD_H_
+#define COMMS_BULK_DOWNLOAD_H_
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+enum pm3_bulk_packet_type {
+    PM3_BULK_IGNORE,
+    PM3_BULK_CHUNK,
+    PM3_BULK_DONE,
+    PM3_BULK_INVALID
+};
+
+typedef struct {
+    enum pm3_bulk_packet_type type;
+    int status;
+    uint32_t offset;
+    uint32_t length;
+    uint32_t bytes_sent;
+    const uint8_t *data;
+} pm3_bulk_packet_t;
+
+typedef enum {
+    PM3_BULK_OK,
+    PM3_BULK_CANCELLED,
+    PM3_BULK_TIMEOUT,
+    PM3_BULK_DISCONNECTED,
+    PM3_BULK_PROTOCOL_ERROR,
+    PM3_BULK_ALLOCATION_FAILED,
+    PM3_BULK_SEND_FAILED
+} pm3_bulk_result_t;
+
+typedef struct {
+    uint64_t (*now)(void *context);
+    bool (*cancelled)(void *context);
+    bool (*connected)(void *context);
+    bool (*send)(void *context, uint32_t start, uint32_t bytes);
+    bool (*receive)(void *context, pm3_bulk_packet_t *packet);
+    void (*idle)(void *context);
+} pm3_bulk_io_t;
+
+static inline void pm3_bulk_decode(pm3_bulk_packet_t *out, bool ng, uint32_t command,
+                                   int status, const uint8_t *data, uint32_t length,
+                                   uint32_t chunk_command, uint32_t done_command,
+                                   uint32_t ack_command) {
+    memset(out, 0, sizeof(*out));
+    out->type = PM3_BULK_IGNORE;
+    out->status = status;
+    if (command == ack_command) {
+        out->type = PM3_BULK_INVALID;
+    } else if (command == chunk_command) {
+        if (ng == false || data == NULL || length < sizeof(uint32_t)) {
+            out->type = PM3_BULK_INVALID;
+            return;
+        }
+        out->type = PM3_BULK_CHUNK;
+        memcpy(&out->offset, data, sizeof(uint32_t));
+        out->length = length - sizeof(uint32_t);
+        out->data = data + sizeof(uint32_t);
+    } else if (command == done_command) {
+        if (ng == false || data == NULL || length != 2 * sizeof(uint32_t)) {
+            out->type = PM3_BULK_INVALID;
+            return;
+        }
+        out->type = PM3_BULK_DONE;
+        memcpy(&out->bytes_sent, data, sizeof(uint32_t));
+    }
+}
+
+static inline pm3_bulk_result_t pm3_bulk_check(const pm3_bulk_io_t *io, void *context,
+                                              uint64_t started, uint64_t timeout_ms) {
+    if (io->cancelled(context)) {
+        return PM3_BULK_CANCELLED;
+    }
+    if (io->connected(context) == false) {
+        return PM3_BULK_DISCONNECTED;
+    }
+    if (timeout_ms != UINT64_MAX && io->now(context) - started >= timeout_ms) {
+        return PM3_BULK_TIMEOUT;
+    }
+    return PM3_BULK_OK;
+}
+
+// A zero segment size keeps the original single-request USB transfer.
+static inline pm3_bulk_result_t pm3_bulk_download_run(uint8_t *dest, uint32_t bytes,
+                                                      uint32_t start_index, uint32_t segment_size,
+                                                      uint64_t timeout_ms, const pm3_bulk_io_t *io,
+                                                      void *context) {
+    if (dest == NULL || io == NULL || io->now == NULL || io->cancelled == NULL ||
+            io->connected == NULL || io->send == NULL || io->receive == NULL ||
+            bytes > UINT32_MAX - start_index) {
+        return PM3_BULK_PROTOCOL_ERROR;
+    }
+    if (bytes == 0) {
+        return PM3_BULK_OK;
+    }
+
+    const uint64_t started = io->now(context);
+    pm3_bulk_result_t result = pm3_bulk_check(io, context, started, timeout_ms);
+    if (result != PM3_BULK_OK) {
+        return result;
+    }
+    uint8_t *staging = malloc(bytes);
+    if (staging == NULL) {
+        return PM3_BULK_ALLOCATION_FAILED;
+    }
+
+    uint32_t completed = 0;
+    while (completed < bytes) {
+        uint32_t requested = bytes - completed;
+        if (segment_size != 0 && requested > segment_size) {
+            requested = segment_size;
+        }
+        result = pm3_bulk_check(io, context, started, timeout_ms);
+        if (result != PM3_BULK_OK) {
+            goto out;
+        }
+        if (io->send(context, start_index + completed, requested) == false) {
+            result = pm3_bulk_check(io, context, started, timeout_ms);
+            if (result == PM3_BULK_OK) {
+                result = PM3_BULK_SEND_FAILED;
+            }
+            goto out;
+        }
+
+        uint32_t received = 0;
+        bool done = false;
+        while (done == false) {
+            result = pm3_bulk_check(io, context, started, timeout_ms);
+            if (result != PM3_BULK_OK) {
+                goto out;
+            }
+            pm3_bulk_packet_t packet = {0};
+            bool available = io->receive(context, &packet);
+            result = pm3_bulk_check(io, context, started, timeout_ms);
+            if (result != PM3_BULK_OK) {
+                goto out;
+            }
+            if (available == false) {
+                if (io->idle != NULL) {
+                    io->idle(context);
+                }
+                continue;
+            }
+            switch (packet.type) {
+                case PM3_BULK_CHUNK:
+                    if (packet.status != 0 || packet.offset != received || packet.length == 0 ||
+                            packet.length > requested - received || packet.data == NULL) {
+                        result = PM3_BULK_PROTOCOL_ERROR;
+                        goto out;
+                    }
+                    memcpy(staging + completed + received, packet.data, packet.length);
+                    received += packet.length;
+                    break;
+                case PM3_BULK_DONE:
+                    if (packet.status != 0 || packet.bytes_sent != requested || received != requested) {
+                        result = PM3_BULK_PROTOCOL_ERROR;
+                        goto out;
+                    }
+                    done = true;
+                    break;
+                case PM3_BULK_IGNORE:
+                    break;
+                case PM3_BULK_INVALID:
+                default:
+                    result = PM3_BULK_PROTOCOL_ERROR;
+                    goto out;
+            }
+        }
+        completed += requested;
+    }
+
+    result = pm3_bulk_check(io, context, started, timeout_ms);
+    if (result == PM3_BULK_OK) {
+        memcpy(dest, staging, bytes);
+    }
+out:
+    free(staging);
+    return result;
+}
+
+#endif
