+typedef struct {
+    PacketResponseNG packet;
+    uint64_t started;
+    bool show_warning;
+    bool cancelled;
+} bulk_download_context_t;
+
+static uint64_t bulk_download_now(void *context) {
+    (void)context;
+    return msclock();
+}
+
+static bool bulk_download_cancelled(void *context) {
+    bulk_download_context_t *download = context;
+    if (download->cancelled == false && kbd_enter_pressed() != 0) {
+        download->cancelled = true;
+    }
+    return download->cancelled;
+}
+
+static bool bulk_download_connected(void *context) {
+    (void)context;
+    return g_session.pm3_present && IsCommunicationThreadDead() == false;
+}
+
+static bool bulk_download_send(void *context, uint32_t start, uint32_t bytes) {
+    if (bulk_download_cancelled(context) || bulk_download_connected(context) == false) {
+        return false;
+    }
+    download_req_t req = {.start_index = start, .bytes = bytes};
+    SendCommandNG(CMD_DOWNLOAD_BIGBUF, (uint8_t *)&req, sizeof(req));
+    return true;
+}
+
+static bool bulk_download_receive(void *context, pm3_bulk_packet_t *packet) {
+    bulk_download_context_t *download = context;
+    if (getReply(&download->packet) == false) {
+        return false;
+    }
+    PacketResponseNG *response = &download->packet;
+    if (response->length > sizeof(response->data.asBytes)) {
+        memset(packet, 0, sizeof(*packet));
+        packet->type = PM3_BULK_INVALID;
+        return true;
+    }
+    pm3_bulk_decode(packet, response->ng, response->cmd, response->status,
+                    response->data.asBytes, response->length,
+                    CMD_DOWNLOADED_BIGBUF, CMD_DOWNLOAD_BIGBUF, CMD_ACK);
+    return true;
+}
+
+static void bulk_download_idle(void *context) {
+    bulk_download_context_t *download = context;
+    if (download->show_warning && msclock() - download->started > 3000) {
+        PrintAndLogEx(INFO, "Waiting for a response from the Proxmark3...");
+        PrintAndLogEx(INFO, "You can cancel this operation by pressing Enter");
+        download->show_warning = false;
+    }
+    xyield();
+}
+
+static uint64_t bulk_download_add_budget(uint64_t budget, uint64_t extra) {
+    return (extra >= UINT64_MAX - budget) ? UINT64_MAX - 1 : budget + extra;
+}
+
+static uint64_t bulk_download_budget(uint32_t bytes, size_t ms_timeout, bool fpc) {
+    if (ms_timeout == (size_t) -1) {
+        return UINT64_MAX;
+    }
+    uint64_t budget = ms_timeout;
+    if (g_conn.uart_speed == 0) {
+        return budget;
+    }
+    uint64_t delay = communication_delay();
+    if (fpc == false) {
+        return bulk_download_add_budget(budget, delay);
+    }
+
+    const uint64_t segments = ((uint64_t)bytes + 511) / 512;
+    const uint64_t response_overhead = sizeof(PacketResponseNGPreamble) + sizeof(PacketResponseNGPostamble);
+    const uint64_t segment_overhead = sizeof(PacketCommandNGPreamble) + sizeof(download_req_t) +
+                                      sizeof(PacketCommandNGPostamble) + 2 * response_overhead +
+                                      sizeof(download_chunk_t) + sizeof(download_done_t);
+    const uint64_t wire_bytes = bytes + segments * segment_overhead;
+    const uint64_t wire_ms = (wire_bytes * 10000 + g_conn.uart_speed - 1) / g_conn.uart_speed;
+    budget = bulk_download_add_budget(budget, wire_ms);
+    return bulk_download_add_budget(budget, 2 * segments * delay);
+}
+
+static bool download_bigbuf(uint8_t *dest, uint32_t bytes, uint32_t start_index,
+                            PacketResponseNG *response, size_t ms_timeout, bool show_warning) {
+    if (start_index > g_pm3_capabilities.bigbuf_size ||
+            bytes > g_pm3_capabilities.bigbuf_size - start_index) {
+        PrintAndLogEx(FAILED, "ERROR: BigBuf download outside device memory");
+        return false;
+    }
+    bulk_download_context_t context = {.started = msclock(), .show_warning = show_warning};
+    const pm3_bulk_io_t io = {
+        .now = bulk_download_now,
+        .cancelled = bulk_download_cancelled,
+        .connected = bulk_download_connected,
+        .send = bulk_download_send,
+        .receive = bulk_download_receive,
+        .idle = bulk_download_idle,
+    };
+    bool fpc = g_conn.send_via_fpc_usart && g_pm3_capabilities.via_fpc && !g_pm3_capabilities.via_usb;
+    uint64_t budget = bulk_download_budget(bytes, ms_timeout, fpc);
+    if (fpc && bytes > 512) {
+        PrintAndLogEx(DEBUG, "BigBuf FPC download: %u bytes, 512-byte segments, total budget %" PRIu64 " ms", bytes, budget);
+    }
+    pm3_bulk_result_t result = pm3_bulk_download_run(dest, bytes, start_index, fpc ? 512 : 0,
+                                                    budget, &io, &context);
+    switch (result) {
+        case PM3_BULK_OK: {
+            *response = context.packet;
+            download_done_t *done = (download_done_t *)response->data.asBytes;
+            done->bytes_sent = bytes;
+            return true;
+        }
+        case PM3_BULK_CANCELLED:
+            PrintAndLogEx(WARNING, "BigBuf download cancelled; partial data discarded");
+            break;
+        case PM3_BULK_TIMEOUT:
+            PrintAndLogEx(FAILED, "Timed out while trying to download data from device");
+            break;
+        case PM3_BULK_DISCONNECTED:
+            PrintAndLogEx(FAILED, "ERROR: device disconnected during BigBuf download");
+            break;
+        case PM3_BULK_PROTOCOL_ERROR:
+            PrintAndLogEx(FAILED, "ERROR: invalid or incomplete BigBuf download; partial data discarded");
+            break;
+        case PM3_BULK_ALLOCATION_FAILED:
+            PrintAndLogEx(FAILED, "ERROR: failed to allocate BigBuf download staging buffer");
+            break;
+        case PM3_BULK_SEND_FAILED:
+        default:
+            PrintAndLogEx(FAILED, "ERROR: failed to send BigBuf download request");
+            break;
+    }
+    return false;
+}
