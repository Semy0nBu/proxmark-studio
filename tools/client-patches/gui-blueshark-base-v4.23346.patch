diff --git a/client/src/proxmark3.c b/client/src/proxmark3.c
index dd0ac05..7d261c6 100644
--- a/client/src/proxmark3.c
+++ b/client/src/proxmark3.c
@@ -41,10 +41,230 @@
 
 #ifndef _WIN32
 #include <locale.h>
+#else
+#include <windows.h>
+#include <io.h>
+#include <fcntl.h>
 #endif
 
 static int mainret = PM3_SUCCESS;
 
+// Host-only bridge for the typed GUI catalog. This does not change firmware.
+static char gui_pipe_token[33] = {0};
+static char gui_pipe_active_id[33] = {0};
+static bool gui_pipe_cancel_requested = false;
+static bool gui_pipe_cancel_break_sent = false;
+static uint64_t gui_pipe_cancel_started = 0;
+static pthread_mutex_t gui_pipe_control_lock = PTHREAD_MUTEX_INITIALIZER;
+#define GUI_PIPE_MAX_LINE 65536
+#define GUI_PIPE_MAX_FIELD 8192
+
+static bool gui_pipe_id_valid(const char *value) {
+    if (strlen(value) != 32) return false;
+    for (size_t i = 0; i < 32; i++) {
+        if (!((value[i] >= '0' && value[i] <= '9') || (value[i] >= 'a' && value[i] <= 'f'))) return false;
+    }
+    return true;
+}
+
+static void gui_pipe_frame_begin(const char *id) {
+    pthread_mutex_lock(&gui_pipe_control_lock);
+    strcpy(gui_pipe_active_id, id);
+    gui_pipe_cancel_requested = false;
+    gui_pipe_cancel_break_sent = false;
+    gui_pipe_cancel_started = 0;
+    pthread_mutex_unlock(&gui_pipe_control_lock);
+}
+
+static void gui_pipe_frame_end(void) {
+    pthread_mutex_lock(&gui_pipe_control_lock);
+    gui_pipe_active_id[0] = '\0';
+    gui_pipe_cancel_requested = false;
+    gui_pipe_cancel_break_sent = false;
+    gui_pipe_cancel_started = 0;
+    pthread_mutex_unlock(&gui_pipe_control_lock);
+}
+
+bool pm3_gui_pipe_cancel_poll(void) {
+    pthread_mutex_lock(&gui_pipe_control_lock);
+#ifdef _WIN32
+    if (gui_pipe_token[0] && gui_pipe_active_id[0] && !gui_pipe_cancel_requested) {
+        // The host waits for BEGIN before sending a control record, so stdio
+        // has not prefetched this later input while reading the request frame.
+        HANDLE input = GetStdHandle(STD_INPUT_HANDLE);
+        for (unsigned int discarded = 0; discarded < 8; discarded++) {
+            char control[74]; // !CANCEL + space + token32 + space + id32 + LF
+            DWORD copied = 0;
+            if (!PeekNamedPipe(input, control, sizeof(control), &copied, NULL, NULL) || copied != sizeof(control)) break;
+            if (memcmp(control, "!CANCEL ", 8) || control[40] != ' ' || control[73] != '\n') break;
+            char token[33] = {0};
+            char id[33] = {0};
+            memcpy(token, control + 8, 32);
+            memcpy(id, control + 41, 32);
+            if (!gui_pipe_id_valid(token) || !gui_pipe_id_valid(id)) break;
+            DWORD consumed = 0;
+            if (!ReadFile(input, control, sizeof(control), &consumed, NULL) || consumed != sizeof(control)) break;
+            // Syntactically valid controls for older/different requests are
+            // discarded without cancelling or touching an ordinary frame.
+            if (!strcmp(token, gui_pipe_token) && !strcmp(id, gui_pipe_active_id)) {
+                gui_pipe_cancel_requested = true;
+                gui_pipe_cancel_started = msclock();
+                break;
+            }
+        }
+    }
+#endif
+    bool requested = gui_pipe_active_id[0] && gui_pipe_cancel_requested;
+    pthread_mutex_unlock(&gui_pipe_control_lock);
+    return requested;
+}
+
+bool pm3_gui_pipe_cancel_take_break(void) {
+    pthread_mutex_lock(&gui_pipe_control_lock);
+    bool send_break = gui_pipe_active_id[0] && gui_pipe_cancel_requested && !gui_pipe_cancel_break_sent;
+    if (send_break) gui_pipe_cancel_break_sent = true;
+    pthread_mutex_unlock(&gui_pipe_control_lock);
+    return send_break;
+}
+
+uint64_t pm3_gui_pipe_cancel_started_at(void) {
+    pthread_mutex_lock(&gui_pipe_control_lock);
+    uint64_t started = gui_pipe_cancel_started;
+    pthread_mutex_unlock(&gui_pipe_control_lock);
+    return started;
+}
+
+static int gui_pipe_hex_digit(char value) {
+    if (value >= '0' && value <= '9') return value - '0';
+    if (value >= 'a' && value <= 'f') return value - 'a' + 10;
+    if (value >= 'A' && value <= 'F') return value - 'A' + 10;
+    return -1;
+}
+
+static bool gui_pipe_utf8_valid(const unsigned char *value) {
+    while (*value) {
+        uint32_t scalar = *value++;
+        unsigned int count;
+        uint32_t minimum;
+        if (scalar < 0x80) continue;
+        if (scalar >= 0xc2 && scalar <= 0xdf) { count = 1; minimum = 0x80; scalar &= 0x1f; }
+        else if (scalar >= 0xe0 && scalar <= 0xef) { count = 2; minimum = 0x800; scalar &= 0x0f; }
+        else if (scalar >= 0xf0 && scalar <= 0xf4) { count = 3; minimum = 0x10000; scalar &= 0x07; }
+        else return false;
+        for (unsigned int i = 0; i < count; i++) {
+            if (*value < 0x80 || *value > 0xbf) return false;
+            scalar = (scalar << 6) | (*value++ & 0x3f);
+        }
+        if (scalar < minimum || scalar > 0x10ffff || (scalar >= 0xd800 && scalar <= 0xdfff)) return false;
+    }
+    return true;
+}
+
+static bool gui_pipe_decode(const char *hex, char *decoded) {
+    size_t length = strlen(hex);
+    if (!length || length % 2 || length / 2 > GUI_PIPE_MAX_FIELD) return false;
+    for (size_t i = 0; i < length; i += 2) {
+        int high = gui_pipe_hex_digit(hex[i]);
+        int low = gui_pipe_hex_digit(hex[i + 1]);
+        if (high < 0 || low < 0) return false;
+        unsigned char value = (unsigned char)((high << 4) | low);
+        if (value == 0 || value == '\r' || value == '\n') return false;
+        decoded[i / 2] = (char)value;
+    }
+    decoded[length / 2] = '\0';
+    return gui_pipe_utf8_valid((const unsigned char *)decoded);
+}
+
+static void gui_pipe_marker(const char *id, const char *phase, int result) {
+    // Firmware debug output shares this lock with ordinary CLI printing.
+    pthread_mutex_lock(&g_print_lock);
+    if (id == NULL) fprintf(stdout, "\n[PM3GUI %s READY]\n", gui_pipe_token);
+    else if (strcmp(phase, "BEGIN") == 0) fprintf(stdout, "\n[PM3GUI %s %s BEGIN]\n", gui_pipe_token, id);
+    else fprintf(stdout, "\n[PM3GUI %s %s END %d]\n", gui_pipe_token, id, result);
+    fflush(stdout);
+    pthread_mutex_unlock(&g_print_lock);
+}
+
+static bool gui_pipe_set_cwd(const char *path) {
+#ifdef _WIN32
+    wchar_t wide[GUI_PIPE_MAX_FIELD + 1];
+    if (MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, path, -1, wide, ARRAYLEN(wide)) == 0) return false;
+    return SetCurrentDirectoryW(wide) != 0;
+#else
+    return chdir(path) == 0;
+#endif
+}
+
+static void gui_pipe_loop(void) {
+    char *line = calloc(GUI_PIPE_MAX_LINE + 1, 1);
+    if (line == NULL) { mainret = PM3_EMALLOC; return; }
+    // preferences_load initializes these to the startup cwd even in incognito.
+    // Empty paths let relative ASCII artifact names follow each request's real
+    // cwd, including a Unicode Windows directory set through the wide API.
+    if (!setDefaultPath(spDefault, "") || !setDefaultPath(spDump, "") || !setDefaultPath(spTrace, "")) {
+        free(line);
+        mainret = PM3_EMALLOC;
+        return;
+    }
+    gui_pipe_marker(NULL, "READY", 0);
+    while (1) {
+        size_t used = 0;
+        bool invalid = false;
+        int input;
+        while ((input = fgetc(stdin)) != EOF && input != '\n') {
+            if (input <= 0 || input > 127 || input == '\r') invalid = true;
+            if (used < GUI_PIPE_MAX_LINE) line[used++] = (char)input;
+            else invalid = true;
+        }
+        if (input == EOF && used == 0) break;
+        line[used] = '\0';
+        // An END/cancel race must never turn a late control into an invalid
+        // request ID or cancel the next request. Controls are not commands.
+        if (used >= 8 && !memcmp(line, "!CANCEL ", 8)) {
+            if (input == EOF) break;
+            continue;
+        }
+        char id[33] = {0};
+        if (used < 33 || line[32] != ' ') {
+            PrintAndLogEx(ERR, "GUI pipe protocol error: missing request ID");
+            mainret = PM3_EINVARG;
+            break;
+        }
+        memcpy(id, line, 32);
+        if (!gui_pipe_id_valid(id)) {
+            PrintAndLogEx(ERR, "GUI pipe protocol error: invalid request ID");
+            mainret = PM3_EINVARG;
+            break;
+        }
+        gui_pipe_frame_begin(id);
+        gui_pipe_marker(id, "BEGIN", 0);
+        char cwd[GUI_PIPE_MAX_FIELD + 1] = {0};
+        char command[GUI_PIPE_MAX_FIELD + 1] = {0};
+        char *cwd_hex = line + 33;
+        char *command_hex = strchr(cwd_hex, ' ');
+        int result = PM3_EINVARG;
+        if (command_hex != NULL && !invalid && input != EOF) {
+            *command_hex++ = '\0';
+            if (gui_pipe_decode(cwd_hex, cwd) && gui_pipe_decode(command_hex, command)) {
+                if (!gui_pipe_set_cwd(cwd)) {
+                    PrintAndLogEx(ERR, "GUI pipe: cannot change working directory");
+                    result = PM3_EFILE;
+                } else {
+                    // Deliberately one dispatch: no legacy semicolon splitting.
+                    result = CommandReceived(command);
+                }
+            }
+        }
+        if (result == PM3_EINVARG) PrintAndLogEx(ERR, "GUI pipe: invalid request or command arguments");
+        gui_pipe_marker(id, "END", result);
+        gui_pipe_frame_end();
+        mainret = result;
+        if (result == PM3_SQUIT) { mainret = PM3_SUCCESS; break; }
+        if (result == PM3_EFATAL || input == EOF) break;
+    }
+    free(line);
+}
