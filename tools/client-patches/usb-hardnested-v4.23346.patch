+
+static void usb_recover_endpoint(AT91PS_UDP pudp, uint8_t endpoint) {
+    // Leave reset and replacement SETUP packets for the outer USB poll.
+    if ((pudp->UDP_ISR & AT91C_UDP_ENDBUSRES) ||
+        (endpoint == AT91C_EP_CONTROL &&
+         (pudp->UDP_CSR[AT91C_EP_CONTROL] & AT91C_UDP_RXSETUP))) {
