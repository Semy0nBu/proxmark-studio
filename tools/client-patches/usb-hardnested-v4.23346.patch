+            flags != AT91C_UDP_RXSETUP && (csr & AT91C_UDP_RXSETUP)) {
+            return false;
+        }
+        if (set ? (csr & flags) != 0 : (csr & flags) == 0) {
+            return true;
+        }
+        if (endpoint != AT91C_EP_CONTROL && !usb_check()) {
+            return false;
+        }
+        WDT_HIT();
+        if (++spins >= USB_TRANSFER_SPIN_LIMIT
+#ifndef AS_BOOTROM
+            || (uint32_t)(GetTickCount() - started) >= USB_TRANSFER_TIMEOUT_MS
+#endif
+           ) {
+            usb_recover_endpoint(pudp, endpoint);
+            return false;
+        }
