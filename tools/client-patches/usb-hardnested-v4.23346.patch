+static uint32_t cpu_search_nonces = 0;
+static uint64_t cpu_search_states = 0;
+
+void hardnested_bruteforce_begin(hardnested_cancel_poll_t poll_cancel) {
+    cancel_poll = poll_cancel;
+    __atomic_store_n(&computation_cancelled, false, __ATOMIC_RELEASE);
+    __atomic_store_n(&computation_failed, false, __ATOMIC_RELEASE);
+    __atomic_store_n(&workers_at_cancel, 0, __ATOMIC_RELAXED);
+    __atomic_store_n(&search_workers_stopped, 0, __ATOMIC_RELAXED);
+    __atomic_store_n(&search_workers_started, 0, __ATOMIC_RELAXED);
+    report_cpu_search = false;
+}
+
+bool hardnested_bruteforce_cancelled(void) {
+    return __atomic_load_n(&computation_cancelled, __ATOMIC_ACQUIRE);
+}
+
+bool hardnested_bruteforce_failed(void) {
+    return __atomic_load_n(&computation_failed, __ATOMIC_ACQUIRE);
+}
+
+bool hardnested_bruteforce_stopped(void) {
+    return hardnested_bruteforce_cancelled() || hardnested_bruteforce_failed();
+}
+
+bool hardnested_bruteforce_poll_cancel(void) {
+    if (!hardnested_bruteforce_cancelled() && cancel_poll && cancel_poll()) {
+        __atomic_store_n(&workers_at_cancel, __atomic_load_n(&workers_active, __ATOMIC_ACQUIRE), __ATOMIC_RELAXED);
+        __atomic_store_n(&computation_cancelled, true, __ATOMIC_RELEASE);
+    }
+    return hardnested_bruteforce_cancelled();
+}
+
+void hardnested_bruteforce_abort(void) {
+    __atomic_store_n(&computation_failed, true, __ATOMIC_RELEASE);
+}
+
+void hardnested_worker_begin(void) {
+    __atomic_fetch_add(&workers_active, 1, __ATOMIC_RELEASE);
+}
+
+void hardnested_worker_end(void) {
+    __atomic_fetch_sub(&workers_active, 1, __ATOMIC_RELEASE);
+}
+
+void hardnested_wait_for_workers(void) {
+    while (__atomic_load_n(&workers_active, __ATOMIC_ACQUIRE)) {
+        if (report_cpu_search && !cpu_search_announced && __atomic_load_n(&search_workers_started, __ATOMIC_ACQUIRE)) {
+            hardnested_print_progress(cpu_search_nonces, "Hardnested CPU search started", cpu_search_states, 0);
+            cpu_search_announced = true;
+        }
+        hardnested_bruteforce_poll_cancel();
+        msleep(5);
+    }
+    hardnested_bruteforce_poll_cancel();
+}
+
+void hardnested_bruteforce_note_search(void) {
+    __atomic_fetch_add(&search_workers_started, 1, __ATOMIC_RELEASE);
+}
+
+void hardnested_bruteforce_note_cancel(void) {
+    __atomic_fetch_add(&search_workers_stopped, 1, __ATOMIC_RELAXED);
+}
+
+uint32_t hardnested_bruteforce_workers_at_cancel(void) {
+    return __atomic_load_n(&workers_at_cancel, __ATOMIC_RELAXED);
+}
+
+uint32_t hardnested_bruteforce_workers_stopped(void) {
+    return __atomic_load_n(&search_workers_stopped, __ATOMIC_RELAXED);
+}
 
