diff --git a/client/src/uart/uart_win32_dcb.h b/client/src/uart/uart_win32_dcb.h
new file mode 100644
index 0000000..dd6e460
--- /dev/null
+++ b/client/src/uart/uart_win32_dcb.h
@@ -0,0 +1,90 @@
+//-----------------------------------------------------------------------------
+// Copyright (C) Proxmark3 contributors. See AUTHORS.md for details.
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// See LICENSE.txt for the text of the license.
+//-----------------------------------------------------------------------------
+
+#ifndef UART_WIN32_DCB_H_
+#define UART_WIN32_DCB_H_
+
+#include <windows.h>
+#include <string.h>
+
+static inline DWORD uart_win32_dcb_error(void) {
+    DWORD error = GetLastError();
+    return error != ERROR_SUCCESS ? error : ERROR_GEN_FAILURE;
+}
+
+static inline DWORD uart_win32_initialize_dcb(HANDLE port, DCB *active,
+                                             const char **failed_api) {
+    if (failed_api != NULL) {
+        *failed_api = "DCB validation";
+    }
+    if (active == NULL) {
+        return ERROR_INVALID_PARAMETER;
+    }
+    DCB candidate;
+    memset(&candidate, 0, sizeof(candidate));
+    candidate.DCBlength = sizeof(candidate);
+    if (!GetCommState(port, &candidate)) {
+        if (failed_api != NULL) *failed_api = "GetCommState";
+        return uart_win32_dcb_error();
+    }
+    candidate.DCBlength = sizeof(candidate);
+    if (!BuildCommDCBA("baud=115200 parity=N data=8 stop=1", &candidate)) {
+        if (failed_api != NULL) *failed_api = "BuildCommDCB";
+        return uart_win32_dcb_error();
+    }
+
+    candidate.fBinary = TRUE;
+    candidate.fParity = FALSE;
+    candidate.fOutxCtsFlow = FALSE;
+    candidate.fOutxDsrFlow = FALSE;
+    candidate.fDtrControl = DTR_CONTROL_DISABLE;
+    candidate.fDsrSensitivity = FALSE;
+    candidate.fTXContinueOnXoff = TRUE;
+    candidate.fOutX = FALSE;
+    candidate.fInX = FALSE;
+    candidate.fErrorChar = FALSE;
+    candidate.fNull = FALSE;
+    candidate.fRtsControl = RTS_CONTROL_DISABLE;
+    candidate.fAbortOnError = FALSE;
+    candidate.fDummy2 = 0;
+    // Windows rejects equal XON/XOFF characters even with flow control disabled.
+    if (candidate.XonChar == candidate.XoffChar) {
+        candidate.XonChar = '\x11';
+        candidate.XoffChar = '\x13';
+    }
+    if (!SetCommState(port, &candidate)) {
+        if (failed_api != NULL) *failed_api = "SetCommState";
+        return uart_win32_dcb_error();
+    }
+    *active = candidate;
+    if (failed_api != NULL) *failed_api = NULL;
+    return ERROR_SUCCESS;
+}
+
+static inline DWORD uart_win32_set_baudrate(HANDLE port, DCB *active, DWORD speed) {
+    if (active == NULL) {
+        return ERROR_INVALID_PARAMETER;
+    }
+    DCB candidate = *active;
+    candidate.BaudRate = speed;
+    if (!SetCommState(port, &candidate)) {
+        return uart_win32_dcb_error();
+    }
+    *active = candidate;
+    return ERROR_SUCCESS;
+}
+
+#endif
