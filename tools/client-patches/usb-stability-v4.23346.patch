+#ifndef PM3_COMMS_HANDSHAKE_H
+#define PM3_COMMS_HANDSHAKE_H
+
+#include <string.h>
+#include "pm3_cmd.h"
+
+#define PM3_HANDSHAKE_PING_SIZE 32u
+
+static inline bool pm3_handshake_ping_matches(const PacketResponseNG *response,
+                                             const uint8_t *expected) {
+    return response != NULL && expected != NULL && response->ng &&
+           response->cmd == CMD_PING && response->status == PM3_SUCCESS &&
+           response->length == PM3_HANDSHAKE_PING_SIZE &&
+           memcmp(response->data.asBytes, expected, PM3_HANDSHAKE_PING_SIZE) == 0;
+}
