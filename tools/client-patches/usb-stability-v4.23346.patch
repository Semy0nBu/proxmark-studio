+// Keep the hardware FIFO bank selection and the software RX/cache state in
+// the same session. Rewriting CSR alone does not reset a ping-pong FIFO.
+static void usb_reset_endpoint(uint32_t mask) {
+    pUdp->UDP_RSTEP = mask;
+    pUdp->UDP_RSTEP = 0;
+    if (mask & (1u << AT91C_EP_OUT)) {
+        usb_reset_rx_state();
+    }
+}
