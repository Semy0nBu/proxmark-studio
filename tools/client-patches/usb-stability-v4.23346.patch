+#ifndef UART_WIN32_IO_H_
+#define UART_WIN32_IO_H_
+
+#include <stdint.h>
+#include <windows.h>
+
+static inline DWORD uart_win32_configure_timeouts(HANDLE port, COMMTIMEOUTS *active,
+                                                 DWORD timeout_ms) {
+    if (active == NULL) {
+        return ERROR_INVALID_PARAMETER;
+    }
+    COMMTIMEOUTS candidate = *active;
+    candidate.ReadIntervalTimeout = timeout_ms;
+    candidate.ReadTotalTimeoutMultiplier = 0;
+    candidate.ReadTotalTimeoutConstant = timeout_ms;
+    candidate.WriteTotalTimeoutMultiplier = timeout_ms;
+    candidate.WriteTotalTimeoutConstant = 0;
+    if (!SetCommTimeouts(port, &candidate)) {
+        return GetLastError();
+    }
+    *active = candidate;
+    return ERROR_SUCCESS;
+}
+
+static inline DWORD uart_win32_query_speed(HANDLE port, DCB *dcb) {
+    return dcb != NULL && GetCommState(port, dcb) ? dcb->BaudRate : 0;
+}
+
+static inline DWORD uart_win32_io_budget(DWORD multiplier, DWORD constant, DWORD length) {
+    const uint64_t budget = (uint64_t)multiplier * length + constant + 250;
+    return budget >= INFINITE ? INFINITE - 1 : (DWORD)budget;
+}
+
+// The kernel's bounded wait may race cancellation. Retire this exact operation
+// before releasing its stack OVERLAPPED, even when cancellation loses the race.
+static inline DWORD uart_win32_finish_io(HANDLE port, OVERLAPPED *operation, BOOL immediate,
+                                         DWORD *count, DWORD wait_ms) {
+    if (immediate) {
+        return ERROR_SUCCESS;
+    }
+    DWORD error = GetLastError();
+    if (error != ERROR_IO_PENDING) {
+        return error;
+    }
+    DWORD wait_result = WaitForSingleObject(operation->hEvent, wait_ms == INFINITE ? INFINITE - 1 : wait_ms);
+    if (wait_result == WAIT_OBJECT_0) {
+        if (GetOverlappedResult(port, operation, count, FALSE)) {
+            return ERROR_SUCCESS;
+        }
+        error = GetLastError();
+        if (error != ERROR_IO_INCOMPLETE) {
+            return error;
+        }
+    } else {
+        error = wait_result == WAIT_TIMEOUT ? ERROR_TIMEOUT : GetLastError();
+    }
+    CancelIoEx(port, operation);
+    GetOverlappedResult(port, operation, count, TRUE);
+    return error;
+}
+
+static inline DWORD uart_win32_read_some(HANDLE port, HANDLE event, uint8_t *buffer,
+                                         DWORD maximum, DWORD *count, DWORD wait_ms) {
+    if (count == NULL) {
+        return ERROR_INVALID_PARAMETER;
+    }
+    *count = 0;
+    if (buffer == NULL || maximum == 0) {
+        return ERROR_INVALID_PARAMETER;
+    }
+    DWORD errors;
+    COMSTAT status;
+    if (!ClearCommError(port, &errors, &status)) {
+        return GetLastError();
+    }
+    if (status.cbInQue == 0) {
+        return ERROR_NO_DATA;
+    }
+    DWORD requested = maximum < status.cbInQue ? maximum : status.cbInQue;
+    OVERLAPPED operation = {0};
+    operation.hEvent = event;
+    if (!ResetEvent(event)) {
+        return GetLastError();
+    }
+    BOOL immediate = ReadFile(port, buffer, requested, count, &operation);
+    DWORD result = uart_win32_finish_io(port, &operation, immediate, count, wait_ms);
+    if (result == ERROR_SUCCESS && *count > requested) {
+        return ERROR_READ_FAULT;
+    }
+    return result;
+}
+
+static inline DWORD uart_win32_write_exact(HANDLE port, HANDLE event, const uint8_t *buffer,
+                                           DWORD length, DWORD *count, DWORD wait_ms) {
+    if (count == NULL) {
+        return ERROR_INVALID_PARAMETER;
+    }
+    *count = 0;
+    if (buffer == NULL && length != 0) {
+        return ERROR_INVALID_PARAMETER;
+    }
+    OVERLAPPED operation = {0};
+    operation.hEvent = event;
+    if (!ResetEvent(event)) {
+        return GetLastError();
+    }
+    BOOL immediate = WriteFile(port, buffer, length, count, &operation);
+    DWORD result = uart_win32_finish_io(port, &operation, immediate, count, wait_ms);
+    if (result == ERROR_SUCCESS && *count != length) {
+        return ERROR_WRITE_FAULT;
+    }
+    return result;
+}
+
+#endif
