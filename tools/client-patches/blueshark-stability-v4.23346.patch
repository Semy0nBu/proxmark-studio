--- /dev/null
+++ b/client/src/uart/frame_reader.h
@@ -0,0 +1,72 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Bounded stream assembly for the framed (not raw) receive path.
+ * uart_receive() is deliberately an "up to" interface: a short successful
+ * read is not a damaged PM3 packet. The same absolute budget covers the
+ * preamble, variable payload and postamble of one packet.
+ */
+#ifndef PM3_UART_FRAME_READER_H
+#define PM3_UART_FRAME_READER_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#define PM3_FRAME_RX_BUDGET_MS 750u
+
+typedef struct {
+    void *context;
+    int (*receive)(void *, uint8_t *, uint32_t, uint32_t *);
+    uint64_t (*now)(void *);
+    bool (*running)(void *);
+    void (*idle)(void *);
+    int success;
+    int no_data;
+    int timeout;
+    int stopped;
+    int invalid;
+    uint32_t budget_ms;
+    uint64_t started_ms;
+    bool active;
+} pm3_frame_reader_t;
+
+/* Call with a fresh reader for each packet, then reuse it for all parts.
+ * Before the first byte, a single empty receive returns immediately so the
+ * communication thread can service TX and wake signals. Once bytes exist,
+ * empty reads/wakes retain them until completion or the absolute deadline.
+ * The callback's own bounded I/O time can overrun this software budget; a
+ * completed read is checked again before being accepted. No I/O is replayed.
+ */
+static inline int pm3_frame_read_exact(pm3_frame_reader_t *reader, uint8_t *output,
+                                      uint32_t length, uint32_t *received) {
+    if (!reader || !received) return reader ? reader->invalid : -1;
+    *received = 0;
+    if (!output || !length || !reader->receive || !reader->now ||
+            !reader->running || !reader->budget_ms) return reader->invalid;
+
+    while (*received < length) {
+        uint64_t before = reader->now(reader->context);
+        uint32_t count = 0;
+        int result;
+        if (!reader->running(reader->context)) return reader->stopped;
+        if (reader->active && before - reader->started_ms >= reader->budget_ms)
+            return reader->timeout;
+
+        result = reader->receive(reader->context, output + *received,
+                                 length - *received, &count);
+        if (count > length - *received) return reader->invalid;
+        if (count && !reader->active) {
+            reader->active = true;
+            reader->started_ms = before;
+        }
+        *received += count;
+        if (result != reader->success && result != reader->no_data) return result;
+        if (!reader->running(reader->context)) return reader->stopped;
+        if (!reader->active) return result;
+        if (reader->now(reader->context) - reader->started_ms >= reader->budget_ms)
+            return reader->timeout;
+        if (*received == length) return reader->success;
+        if (!count && reader->idle) reader->idle(reader->context);
+    }
+    return reader->success;
+}
+
+#endif
--- /dev/null
+++ b/client/src/uart/tx_lifecycle.h
@@ -0,0 +1,38 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#ifndef PM3_UART_TX_LIFECYCLE_H
+#define PM3_UART_TX_LIFECYCLE_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <pthread.h>
+
+/* Success transfers the locked mutex to the caller, which can enqueue one
+ * command. Failure releases it. A dead receive thread must never leave a
+ * producer asleep waiting for a previous command that cannot be transmitted.
+ */
+static inline bool pm3_tx_lock_ready(pthread_mutex_t *mutex, pthread_cond_t *changed,
+                                     bool *pending, const bool *dead) {
+    pthread_mutex_lock(mutex);
+    while (*pending && !__atomic_load_n(dead, __ATOMIC_SEQ_CST)) {
+        pthread_cond_wait(changed, mutex);
+    }
+    if (__atomic_load_n(dead, __ATOMIC_SEQ_CST)) {
+        pthread_mutex_unlock(mutex);
+        return false;
+    }
+    return true;
+}
+
+/* Serialize death publication with enqueue, drop unsent data and wake every
+ * blocked producer. This runs before closing the UART handle. */
+static inline void pm3_tx_stop(pthread_mutex_t *mutex, pthread_cond_t *changed,
+                               bool *pending, size_t *ng_length, bool *dead) {
+    pthread_mutex_lock(mutex);
+    __atomic_store_n(dead, true, __ATOMIC_SEQ_CST);
+    *pending = false;
+    *ng_length = 0;
+    pthread_cond_broadcast(changed);
+    pthread_mutex_unlock(mutex);
+}
+
+#endif
