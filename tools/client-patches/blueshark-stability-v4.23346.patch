@@ -0,0 +1,50 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// WaitCommEvent completion must outlive its OVERLAPPED and event-mask storage.
+#ifndef UART_WIN32_WAIT_H
+#define UART_WIN32_WAIT_H
+
+#include <windows.h>
+
+typedef enum {
+    UART_COMM_WAIT_READY,
+    UART_COMM_WAIT_EMPTY,
+    UART_COMM_WAIT_WAKE,
+    UART_COMM_WAIT_ERROR
+} uart_comm_wait_result_t;
+
+/* Called only after WaitCommEvent returned ERROR_IO_PENDING. Even when
+ * cancellation reports ERROR_NOT_FOUND, completion can have won the race:
+ * GetOverlappedResult(TRUE) must retire that same operation before its caller
+ * returns or reuses the stack OVERLAPPED/event mask. Only the wait is cancelled;
+ * no ReadFile is cancelled and queued serial bytes are left untouched.
+ */
+static inline uart_comm_wait_result_t uart_complete_comm_wait(
+    HANDLE port, HANDLE wake_event, OVERLAPPED *operation, DWORD wait_result) {
+    const BOOL cancel_wait = wait_result != WAIT_OBJECT_0;
+    if (wait_result == WAIT_OBJECT_0 + 1) {
+        ResetEvent(wake_event);
+    }
+    if (cancel_wait) {
+        /* Requesting cancellation does not wait for the operation to finish. */
+        CancelIoEx(port, operation);
+    }
+
+    DWORD transferred = 0;
+    const BOOL completed = GetOverlappedResult(port, operation, &transferred, TRUE);
+    const DWORD error = completed ? ERROR_SUCCESS : GetLastError();
+    if (!completed && error != ERROR_OPERATION_ABORTED) {
+        return UART_COMM_WAIT_ERROR;
+    }
+    if (wait_result == WAIT_TIMEOUT) {
+        return UART_COMM_WAIT_EMPTY;
+    }
+    if (wait_result == WAIT_OBJECT_0 + 1) {
+        return UART_COMM_WAIT_WAKE;
+    }
+    if (wait_result != WAIT_OBJECT_0) {
+        return UART_COMM_WAIT_ERROR;
+    }
+    return completed ? UART_COMM_WAIT_READY : UART_COMM_WAIT_WAKE;
+}
+
+#endif
